srun --unbuffered --label python -u run_experiments_real_networks.py \
  --model_name diffpool \
  --p_values 0.5 \
  --network_name BitcoinTransactions \
  --num_layers 1 \
  --lr 0.01 \
  --epochs 500 \
  --dropout 0 \
  --regularization 0.5 \
  --outfile_csv results_dice_diffpool_real_networks/diffpool_dice_original_btc.csv
status=$?
echo "[SLURM] run_experiments_real_networks.py exit code = $status"
exit $status

