#!/bin/bash
#SBATCH --job-name=test_gnn_dice60_grid
#SBATCH --partition=gpu-debug
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --time=1:00:00
#SBATCH --mem=100G
#SBATCH -A r01712
#SBATCH --array=0-2
#SBATCH --output=logs/test_gnn_%A_%a.out
#SBATCH --error=logs/test_gnn_%A_%a.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dmanato@iu.edu

set -euo pipefail

module purge
module load python/gpu/3.11.5
module load cudatoolkit/11.8

cd "$SLURM_SUBMIT_DIR/gnn-clustering-attack-defense"

mkdir -p logs
mkdir -p test_results

line=$(sed -n "$((SLURM_ARRAY_TASK_ID+1))p" test_params.tsv)

# shellcheck disable=SC2086
eval "$line"

: "${model:?missing model}"
: "${mu:?missing mu}"
: "${sigma_c:?missing sigma_c}"
: "${minc:?missing minc}"
: "${seed:?missing seed}"
: "${pvals:?missing pvals}"
: "${attack:?missing attack}"
: "${feature:?missing feature}"
: "${outfile:?missing outfile}"

echo "[SLURM] Job $SLURM_JOB_ID task $SLURM_ARRAY_TASK_ID on $(hostname)"
echo "[SLURM] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES-}"
echo "[SLURM] model=$model attack=$attack mu=$mu sigma_c=$sigma_c pvals=[$pvals] feature=$feature minc=$minc seed=$seed"

ATTACK_ARG=()
if [[ "$attack" == "fcomdice" ]]; then
  ATTACK_ARG=(--FComDICE)
elif [[ "$attack" == "dice" ]]; then
  ATTACK_ARG=(--no-FComDICE)
else
  echo "[ERROR] Unknown attack=$attack. Expected dice or fcomdice."
  exit 1
fi

FEATURE_ARG=()
if [[ "$feature" != "None" ]]; then
  FEATURE_ARG=(--attack_feature_mode "$feature")
fi

srun --unbuffered --label python -u run_experiments.py \
  --model_name "$model" \
  --mu_values "$mu" \
  --sigma_c_values "$sigma_c" \
  --min_community "$minc" \
  --seed "$seed" \
  --realizations 2 \
  --b_percentages 0.01 \
  --p_values $pvals \
  "${ATTACK_ARG[@]}" \
  "${FEATURE_ARG[@]}" \
  --outfile_csv "test_results/${outfile}"

status=$?
echo "[SLURM] run_experiments.py exit code = $status"
exit $status