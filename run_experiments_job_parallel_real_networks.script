#!/bin/bash

#SBATCH --job-name=fb_mincut_orig         # Job name for the array
#SBATCH --partition=gpu                 # Partition (queue) name
#SBATCH --output=logs/%x_%A_%a.out      # Output file for stdout (%A: array job ID, %a: task ID)
#SBATCH --error=logs/%x_%A_%a.err       # Output file for stderr (%A: array job ID, %a: task ID)
#SBATCH --mail-type=ALL                 # Email notification for job events
#SBATCH --mail-user=dmanato@iu.edu      # Email address to receive notifications
#SBATCH --nodes=1                       # Number of nodes
#SBATCH --ntasks-per-node=1             # Number of tasks per node
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16              # Number of CPU cores per task
#SBATCH --time=2-00:00:00                 # Wall clock time limit
#SBATCH --mem=100G                      # Memory limit per node
#SBATCH -A r01712                       # Account (project) allocation
#SBATCH --exclude=nid0689,nid0698,nid0702 # exclude nid0689 due to GPU issues
#SBATCH --array=0-9                 # Number of tasks in the array (0 to 7, 8 tasks in total)


set -euo pipefail
module purge
module load python/gpu/3.11.5
module load cudatoolkit/11.8
mkdir -p logs

# Make Python chatty & unbuffered
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# export CUDA_LAUNCH_BLOCKING=1


echo "[SLURM] JobID: $SLURM_JOB_ID  Node: $(hostname)"
echo "[SLURM] NodeList: ${SLURM_NODELIST-}  SubmitDir: ${SLURM_SUBMIT_DIR-}"

# Preflight GPU
python - <<'PY' || { echo "Preflight CUDA test failed"; exit 1; }
import os, torch
print("torch.__version__ =", torch.__version__)
print("torch.version.cuda =", torch.version.cuda)
print("is_available =", torch.cuda.is_available())
print("device_count =", torch.cuda.device_count())
print("CUDA_VISIBLE_DEVICES =", os.environ.get("CUDA_VISIBLE_DEVICES"))
if not torch.cuda.is_available(): raise SystemExit("No CUDA device visible to PyTorch.")
x = torch.randn(2,2, device='cuda'); print("CUDA tensor OK:", x.shape)
PY

# Go to project
cd "$SLURM_SUBMIT_DIR/gnn-clustering-attack-defense"
mkdir -p results_dice_diffpool_real_networks
mkdir -p results_fcomdice_diffpool_real_networks
mkdir -p results_dice_mincut_real_networks
mkdir -p results_fcomdice_mincut_real_networks
# pwd; ls -al

# prove imports won’t crash before your prints:
python - <<'PY'
import sys
print("Import smoke test start", flush=True)
import attacks, dmon, torch_geometric
print("Imports OK", flush=True)
PY

line=$(sed -n "$((SLURM_ARRAY_TASK_ID+1))p" params_fb_mincut_original_features.tsv)
eval "$line"

: "${model:?missing model}"
: "${attack:?missing attack}"
# : "${sigma_c:?missing sigma_c}"
: "${feature:?missing feature}"
: "${outfile:?missing outfile}"
: "${batch:?missing batch}"

echo "[SLURM] Job $SLURM_JOB_ID task $SLURM_ARRAY_TASK_ID on $(hostname)"
# echo "[SLURM] model=$model attack=$attack featurized_sigma_c=$sigma_c feature=$feature batch=$batch outfile=$outfile"
echo "[SLURM] model=$model attack=$attack feature=$feature batch=$batch outfile=$outfile"
ATTACK_ARG=()
# OUTDIR="results_dice_mincut_real_networks"
OUTDIR="results_${attack}_${model}_real_networks"

if [[ "$attack" == "fcomdice" ]]; then
  ATTACK_ARG=(--FComDICE)
  # OUTDIR="results_fcomdice_mincut_real_networks"
elif [[ "$attack" == "dice" ]]; then
  ATTACK_ARG=(--no-FComDICE)
else
  echo "[ERROR] Unknown attack=$attack. Expected dice or fcomdice."
  exit 1
fi

FEATURE_ARG=()
if [[ "$feature" != "None" ]]; then
  FEATURE_ARG=(--attack_feature_mode "$feature")
fi

#   # DICE on featurized BitcoinTransactions with consensus Louvain true labels

# srun --unbuffered --label python -u run_experiments_real_networks.py \
#   --model_name "$model" \
#   --p_values 0.5 \
#   --realizations 5 \
#   --featurized \
#   --featurized_sigma_c "$sigma_c" \
#   --network_name BitcoinTransactions \
#   --num_layers 1 \
#   --lr 0.001 \
#   --epochs 500 \
#   --dropout 0.2 \
#   --regularization 0.5 \
#   "${ATTACK_ARG[@]}" \
#   "${FEATURE_ARG[@]}" \
#   --outfile_csv "${OUTDIR}/${outfile}"

# original features
srun --unbuffered --label python -u run_experiments_real_networks.py \
  --model_name "$model" \
  --p_values 0.5 \
  --realizations 10 \
  --network_name Facebook \
  --num_layers 2 \
  --lr 0.001 \
  --epochs 500 \
  --dropout 0.2 \
  --regularization 0.5 \
  "${ATTACK_ARG[@]}" \
  "${FEATURE_ARG[@]}" \
  --outfile_csv "${OUTDIR}/${outfile}"

status=$?
echo "[SLURM] exit code = $status"
exit $status
