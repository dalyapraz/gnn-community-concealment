#!/bin/bash

#SBATCH --job-name=consensus_BitcoinTransactions    # Job name for the array
#SBATCH --partition=gpu-debug            # Partition (queue) name
#SBATCH --output=logs/%x_%A_%a.out      # Output file for stdout (%A: array job ID, %a: task ID)
#SBATCH --error=logs/%x_%A_%a.err       # Output file for stderr (%A: array job ID, %a: task ID)
#SBATCH --mail-type=ALL                 # Email notification for job events
#SBATCH --mail-user=dmanato@iu.edu      # Email address to receive notifications
#SBATCH --nodes=1                       # Number of nodes
#SBATCH --ntasks-per-node=1             # Number of tasks per node
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=16              # Number of CPU cores per task
#SBATCH --time=1:00:00                 # Wall clock time limit
#SBATCH --mem=100G                      # Memory limit per node
#SBATCH -A r01712                       # Account (project) allocation
#SBATCH --array=0                  # Number of tasks in the array (0 to 7, 8 tasks in total)



set -euo pipefail
set -x   # trace commands

mkdir -p logs
mkdir -p featurized_graphs

# Make Python chatty & unbuffered
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export CUDA_LAUNCH_BLOCKING=1

module purge
# module load python/gpu/3.11.5 # not available any more on big red 
# module load cudatoolkit/11.8
module load python/gpu/3.10.10

echo "[SLURM] JobID: $SLURM_JOB_ID  Node: $(hostname)"
echo "[SLURM] NodeList: ${SLURM_NODELIST-}  SubmitDir: ${SLURM_SUBMIT_DIR-}"

# Preflight GPU
python - <<'PY' || { echo "Preflight CUDA test failed"; exit 1; }
import os, torch
print("torch.__version__ =", torch.__version__)
print("torch.version.cuda =", torch.version.cuda)
print("is_available =", torch.cuda.is_available())
print("device_count =", torch.cuda.device_count())
print("CUDA_VISIBLE_DEVICES =", os.environ.get("CUDA_VISIBLE_DEVICES"))
if not torch.cuda.is_available(): raise SystemExit("No CUDA device visible to PyTorch.")
x = torch.randn(2,2, device='cuda'); print("CUDA tensor OK:", x.shape)
PY

# Go to your project
cd "$SLURM_SUBMIT_DIR/gnn-clustering-attack-defense"
# pwd; ls -al

# (Optional) prove imports won’t crash before your prints:
python - <<'PY'
import sys
print("Import smoke test start", flush=True)
import attacks, dmon, torch_geometric
print("Imports OK", flush=True)
PY

echo "[SLURM] Launching run_experiments_real_networks.py at $(date)"

# DICE on  BitcoinTransactions with consensus Louvain true labels
srun --unbuffered --label python -u run_experiments_real_networks.py \
  --p_values 0.5 \
  --b_percentages 0.01 \
  --realizations 1 \
  --consensus \
  --consensus_labels_file BitcoinTransactions_consensus_louvain.membership \
  --network_name BitcoinTransactions \
  --outfile_csv test_dice_BitcoinTransactions_consensus_louvain.csv
status=$?
echo "[SLURM] run_experiments_real_networks.py exit code = $status"
exit $status


