#!/bin/bash

#SBATCH --job-name=consensus_metrics
#SBATCH --partition=gpu-debug
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dmanato@iu.edu

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=100G
#SBATCH --time=1:00:00
#SBATCH -A r01712

# optional array (set to 0 if single dataset)
#SBATCH --array=0

set -euo pipefail
set -x

mkdir -p logs

# ----------------------------
# Threading control (IMPORTANT)
# ----------------------------
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export PYTHONNOUSERSITE=1 # This prevents pip from silently installing things in ~/.local
# ----------------------------
# Environment
# ----------------------------
module purge
module load python/3.11.13    # CPU python, NOT python/gpu
source ~/venvs/consensus_cpu/bin/activate


# module load python/gpu/3.11.5

echo "[SLURM] JobID: $SLURM_JOB_ID"
echo "[SLURM] Node: $(hostname)"
echo "[SLURM] CPUs: $SLURM_CPUS_PER_TASK"
echo "[SLURM] Submit dir: $SLURM_SUBMIT_DIR"

# ----------------------------
# Project directory
# ----------------------------
cd "$SLURM_SUBMIT_DIR/gnn-clustering-attack-defense"

mkdir -p results_fcomdice_real_networks_consensus

# ----------------------------
# Lightweight import smoke test
# ----------------------------
python - <<'PY'
import torch, os
print("Torch version:", torch.__version__)
print("CUDA available:", torch.cuda.is_available())
print("OMP threads:", os.environ.get("OMP_NUM_THREADS"))
print("Imports OK")
PY

python - <<'PY'
import sys, site
print("Python exe:", sys.executable)
print("sys.path:")
for p in sys.path:
    print(" ", p)
print("site-packages:", site.getsitepackages())
print("user site:", site.getusersitepackages())
PY


# ----------------------------
# Dataset selection
# ----------------------------
DATASETS=(
    BlogCatalog
    Actor
    BitcoinTransactions
)

DATASET=${DATASETS[$SLURM_ARRAY_TASK_ID]}

echo "[SLURM] Running dataset: $DATASET"
echo "[SLURM] Start time: $(date)"

# ----------------------------
# Run your code
# ----------------------------
python run_metrics_real_networks.py --dataset "$DATASET"

echo "[SLURM] Finished at: $(date)"
